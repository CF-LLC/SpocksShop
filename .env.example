# Copy to .env and never commit .env
# Used by Docker Compose and the Next.js app.

POSTGRES_USER=spocks
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=spocks_shop
DATABASE_URL=postgres://spocks:change-me-now@db:5432/spocks_shop

# When running Next on the host against Docker Postgres:
# DATABASE_URL=postgres://spocks:change-me-now@127.0.0.1:5432/spocks_shop

ADMIN_EMAIL=admin@spockshop.com
# Generate: node -e "const {scryptSync,randomBytes}=require('crypto'); const s=randomBytes(16).toString('hex'); const h=scryptSync('your-password',s,64).toString('hex'); console.log(s+':'+h)"
ADMIN_PASSWORD_HASH=

SESSION_SECRET=replace-with-32-plus-random-bytes
APP_URL=http://localhost:3000

# Leave empty until checkout phase. Never commit live secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout stays OFF until this is exactly "true" (and STRIPE_SECRET_KEY is set).
STRIPE_CHECKOUT_ENABLED=false
# Stripe Tax (off by default). Needs Stripe Tax activated + an Arkansas registration in the dashboard.
STRIPE_TAX_ENABLED=false
# Optional overrides (defaults: txcd_99999999 general tangible goods, txcd_92010001 shipping).
STRIPE_PRODUCT_TAX_CODE=
STRIPE_SHIPPING_TAX_CODE=
# Optional; not needed for hosted Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

BACKUP_DIR=/var/spocks/backups

# Community Market seller signup + dashboard (/sell). Off unless "true".
COMMUNITY_SELLERS_ENABLED=false
# Uploaded photos (Docker volume spocks_media)
MEDIA_DIR=/var/spocks/media
# Optional: cloudflared metrics base URL for /admin/health (e.g. http://host.docker.internal:20241).
# If unset or unreachable, health does an HTTPS self-check of APP_URL/api/health instead.
CLOUDFLARED_METRICS_URL=

# --- AI listing suggestions (server-only; never prefix with NEXT_PUBLIC_) ---
# Unset AI_API_KEY = the AI button is hidden and the photo-first flow works without it.
AI_PROVIDER=anthropic            # anthropic (recommended) | gemini
AI_MODEL=                        # default: claude-haiku-5-5 (anthropic) / gemini-3.1-flash-lite (gemini)
AI_API_KEY=
AI_DAILY_LIMIT=50                # per user per 24h
AI_PER_MINUTE_LIMIT=6
# AI_PRICE_INPUT_PER_M= / AI_PRICE_OUTPUT_PER_M=   override list prices used for cost estimates

# --- Seller AI billing (Community Market, off until launch) ---
AI_SELLER_BILLING_ENABLED=false
AI_CREDIT_PACK_SIZE=25
STRIPE_PRICE_AI_CREDIT_PACK=     # one-time price id (create in Stripe Dashboard later)
STRIPE_PRICE_AI_PLAN_MONTHLY=    # recurring monthly price id (optional)

# --- Order approval (manual capture) ---
# Items with "Requires my approval" (default on for Closet Picks) are only authorized at checkout;
# accept/decline in /admin/orders. Holds auto-cancel after 6 days (reminders at 24h and day 5).
ORDER_NOTIFY_EMAIL=              # where approval alerts and blog draft-ready emails go (falls back to ADMIN_EMAIL)
ORDER_APPROVAL_SWEEP_MINUTES=15  # in-process hold sweep; 0 = off (then run `npm run holds:sweep` from cron)
# Email: log-only until a provider is configured.
MAIL_PROVIDER=log                # log | resend
MAIL_FROM=                       # e.g. Spock's Shop <orders@spockshop.com>
RESEND_API_KEY=

# --- Blog ---
# Drafts arrive via POST /api/blog/drafts (docs/blog-draft-api.md). Unset token = API off (503).
BLOG_DRAFT_TOKEN=                # openssl rand -hex 32
BLOG_AI_SCHEDULE=off             # "on" re-enables scheduled AI drafts (then BLOG_DRAFTS_PER_WEEK, default 3)

# USPS labels via Shippo (docs/shipping-labels.md). Server-only; leave blank until Cooper adds the key.
SHIPPO_API_KEY=
# Return addresses are saved per account in Admin -> Settings (sellers: their dashboard), not in env.
# Buyer "your order shipped" email. Off by default.
SHIPPING_TRACKING_EMAIL_ENABLED=false
